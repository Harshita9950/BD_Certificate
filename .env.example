# ─────────────────────────────────────────────────────────────────────────────
# TL_portal — Environment Variable Template
# Copy to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django Core ───────────────────────────────────────────────────────────────
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_NAME=tl_portal_db
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_COOKIE_NAME=tl_sessionid
SESSION_COOKIE_AGE=28800
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
SESSION_EXPIRE_AT_BROWSER_CLOSE=False

# ── CSRF ──────────────────────────────────────────────────────────────────────
CSRF_COOKIE_NAME=tl_csrftoken
CSRF_COOKIE_SECURE=False
CSRF_COOKIE_SAMESITE=Lax
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Timezone ──────────────────────────────────────────────────────────────────
TIME_ZONE=Asia/Kolkata

# ── Email (SMTP — production only; dev uses console backend automatically) ────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@municipality.gov.in

# ─────────────────────────────────────────────────────────────────────────────
# CENTRAL PORTAL / SSO
# Leave all blank and CENTRAL_PORTAL_ENABLED=False for local-only mode.
# Fill these only when CP integration begins.
# See core/authentication/client.py and central_portal.py for implementation.
# ─────────────────────────────────────────────────────────────────────────────
CENTRAL_PORTAL_ENABLED=False
CENTRAL_PORTAL_URL=
CENTRAL_PORTAL_CLIENT_ID=
CENTRAL_PORTAL_CLIENT_SECRET=
CENTRAL_PORTAL_REDIRECT_URI=https://your-domain.gov.in/api/auth/sso/callback/
CENTRAL_PORTAL_APPLICATION_CODE=BIRTH_DEATH
CENTRAL_PORTAL_LOGIN_URL=
CENTRAL_PORTAL_CALLBACK_URL=
CENTRAL_PORTAL_LOGOUT_URL=
CENTRAL_PORTAL_PROPAGATE_LOGOUT=False

# ─────────────────────────────────────────────────────────────────────────────
# RAZORPAY PAYMENT GATEWAY
# Obtain these from https://dashboard.razorpay.com/app/keys
# KEY_ID  is safe to use in the browser (Razorpay checkout.js).
# KEY_SECRET must NEVER leave the server — used only for HMAC verification.
# Leave both blank to disable online payments (cash-only mode still works).
# ─────────────────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your-razorpay-key-secret-here
RAZORPAY_CURRENCY=INR
